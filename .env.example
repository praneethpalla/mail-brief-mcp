# mail-brief-mcp settings. Copy to .env. This file never contains your password.

# Your email address (the IMAP login)
MAIL_ADDRESS=you@yahoo.com

# A command that prints your app password from a password store (required; plain-text passwords are refused).
# macOS Keychain (store it first; you'll be prompted, input hidden):
#   security add-generic-password -a you@yahoo.com -s mail-brief-mcp -T "" -w
MAIL_PASSWORD_COMMAND=security find-generic-password -a you@yahoo.com -s mail-brief-mcp -w
# Windows Credential Manager (store it first: powershell -NoProfile -ExecutionPolicy Bypass -File scripts\windows-credential.ps1 -Set -User you@example.com):
#   MAIL_PASSWORD_COMMAND=powershell -NoProfile -ExecutionPolicy Bypass -File "C:\path\to\mail-brief-mcp\scripts\windows-credential.ps1"
# Others: op read "op://Private/Mail/password" | secret-tool lookup service mail-brief-mcp | pass show mail-brief-mcp

# IMAP server (default: Yahoo). Examples: imap.aol.com, imap.mail.me.com (iCloud), imap.fastmail.com, imap.zoho.com, imap.gmail.com
# (Outlook / Microsoft 365 requires OAuth and isn't supported yet; see README "Providers")
# IMAP_HOST=imap.mail.yahoo.com
# IMAP_PORT=993

# READ_ONLY=true removes the draft tools (the server can then only read)
# READ_EMAIL_MAX_CHARS=20000
# DRAFTS_FOLDER=Draft
# SAFETY_HOOKS_MODULE=/path/to/my-hooks.mjs
